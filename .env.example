# Copy to .env.local for local dev, and add the same keys to your hosting env settings.

# Google Analytics 4
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Public site URL (no trailing slash) — used for sitemap.xml & robots.txt
VITE_SITE_URL=https://ponsaryay.infiniteframe.online

# Google AdSense publisher ID (from AdSense > Account > Account information)
VITE_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX

# Ad unit slot IDs (AdSense > Ads > By ad unit). Leave empty to use Auto Ads only.
VITE_ADSENSE_SLOT_DISPLAY=
VITE_ADSENSE_SLOT_ARTICLE=
